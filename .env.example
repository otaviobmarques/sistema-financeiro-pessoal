DATABASE_URL="postgresql://sobbra:sobbra@localhost:5432/sobbra"
AUTH_SECRET=""    # gere com: openssl rand -base64 32
# Chave de 32 bytes em hex para criptografar comprovantes (AES-256-GCM)
FILE_ENC_KEY=""   # gere com: openssl rand -hex 32
# Gateway de IA (secao 8.2). Vazio = modo sem IA (parser local + regras)
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
ADMIN_EMAILS="admin@sobbra.app"
# Notificacoes push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:suporte@seudominio.com.br"
# Protege a rota /api/cron/alerts (chame a cada hora pelo agendador da hospedagem)
CRON_SECRET=""
# NFC-e: provedor de consulta (opcional). Sem ele, o Sobbra consulta o portal publico da SEFAZ pela URL do QR Code
NFCE_API_URL=""
NFCE_API_KEY=""
